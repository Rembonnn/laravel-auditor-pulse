includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Views are registered under the auditor-pulse:: namespace at runtime.
        -
            message: '#expects view-string, string given#'
            identifier: argument.type
