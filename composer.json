{
    "name": "rembon/laravel-auditor-pulse",
    "description": "Laravel Pulse cards for Laravel Auditor: denied abilities, top model changes and most active users.",
    "keywords": ["laravel", "pulse", "audit", "audit-trail", "laravel-auditor"],
    "homepage": "https://github.com/Rembonnn/laravel-auditor-pulse",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "dayCod",
            "email": "alayarahman07@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "laravel/pulse": "^1.8",
        "rembon/laravel-auditor": "^3.0@beta"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rembon\\LaravelAuditorPulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rembon\\LaravelAuditorPulse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rembon\\LaravelAuditorPulse\\AuditorPulseServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
